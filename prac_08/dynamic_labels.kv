#:kivy 2.1.0
BoxLayout:
    orientation: 'vertical'
    padding: 10
    spacing: 5
    
    ScrollView:
        BoxLayout:
            id: labels_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height  
            
    Label:
        size_hint_y: 0.1
        text: "Total: {} names".format(len(app.names))
        color: (0.8, 0.2, 0.2, 1)  