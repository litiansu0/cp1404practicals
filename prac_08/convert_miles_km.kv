#:kivy 2.1.0
BoxLayout:
    orientation: 'vertical'
    
    BoxLayout:
        orientation: 'horizontal'
        TextInput:
            id: input_miles
            text: '0'
            font_size: 48
            on_text: app.update_km_from_input()
        
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.3
            Button:
                text: 'Up'
                font_size: 48
                on_press: app.increment_miles(1)
            Button:
                text: 'Down'
                font_size: 48
                on_press: app.increment_miles(-1)
    
    Label:
        id: output_km
        text: '0.0'
        font_size: 48
        color: (1, 1, 0, 1)